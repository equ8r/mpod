# MicahPod local environment (do not commit real secrets)
# Copy to `.env` / server parent `.env` as needed.

# Database
DB_HOST=localhost
DB_NAME=micahpod_db
DB_USER=
DB_PASS=

# Email (digest)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=micahpod@example.com
SMTP_FROM_NAME=MicahPod
DIGEST_KEY=

# Deployment (DreamHost / SFTP)
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASS=
DEPLOY_PATH=/home/USER/example.com/micahpod
