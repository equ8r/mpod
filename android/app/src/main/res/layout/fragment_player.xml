<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Empty state -->
    <TextView
        android:id="@+id/emptyStateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No episode loaded.\nSelect one from Feed or Podcasts."
        android:textAlignment="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:alpha="0.5"
        android:visibility="gone" />

    <!-- Player content -->
    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/artworkImage"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:contentDescription="Artwork" />

        <TextView
            android:id="@+id/episodeTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textAlignment="center"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/podcastTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textAlignment="center"
            android:alpha="0.7"
            android:maxLines="1"
            android:ellipsize="end" />

        <com.google.android.material.slider.Slider
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:valueFrom="0"
            android:valueTo="100"
            android:value="0"
            android:stepSize="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="-8dp">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:text="0:00" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textAlignment="textEnd"
                android:text="0:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipBackButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:icon="@drawable/ic_skip_back_15"
                app:iconSize="32dp"
                app:iconTint="?attr/colorOnSurface"
                android:contentDescription="Skip back 30s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playPauseButton"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:icon="@drawable/ic_play"
                app:iconSize="40dp"
                android:contentDescription="Play/Pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/skipForwardButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:icon="@drawable/ic_skip_forward_30"
                app:iconSize="32dp"
                app:iconTint="?attr/colorOnSurface"
                android:contentDescription="Skip forward 30s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveProgressButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_progress" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/markPlayedButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/mark_played" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/queueButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/queue" />

        <TextView
            android:id="@+id/saveStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.7" />
    </LinearLayout>
</FrameLayout>
