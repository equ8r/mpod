<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="10dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/episodePlayedBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC1F9BB4"
            android:gravity="center"
            android:paddingVertical="3dp"
            android:text="@string/played_banner"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:visibility="gone" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <ImageView
                android:id="@+id/episodeArtwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/episodes"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/episodeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:layout_constraintStart_toEndOf="@id/episodeArtwork"
                app:layout_constraintTop_toTopOf="@id/episodeArtwork"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/episodePodcast"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                app:layout_constraintStart_toStartOf="@id/episodeTitle"
                app:layout_constraintTop_toBottomOf="@id/episodeTitle"
                app:layout_constraintEnd_toEndOf="parent"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/episodeMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                app:layout_constraintStart_toStartOf="@id/episodeTitle"
                app:layout_constraintTop_toBottomOf="@id/episodePodcast"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
